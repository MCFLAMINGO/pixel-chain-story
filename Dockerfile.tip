# Pixel Ledger — canonical tip host (RPC for Billboard + /wallet)
# Build:  docker build -f Dockerfile.tip -t pixel-tip .
# Run:    docker run -d -p 8545:8545 -v pixel-tip-data:/data/pixel -e PORT=8545 pixel-tip
# Railway: set Dockerfile path to Dockerfile.tip; attach a volume at /data/pixel

FROM oven/bun:1.2-alpine

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
# Bun's --production is a flag (no =false). Tip needs runtime deps from lockfile.
RUN bun install --frozen-lockfile

COPY src ./src
COPY scripts/run-canonical-tip.ts ./scripts/run-canonical-tip.ts
# tsconfig paths (`@/*`) required — node loads Lumen which imports `@/lib/pixel`.

ENV PIXEL_DATADIR=/data/pixel
ENV PORT=8545
ENV PIXEL_GOSSIP_PORT=9001
# Friend tip: phone Bridge + faucet for new pay faces (lab, not mainnet claim)
ENV PIXEL_BRIDGE_LAB=1
ENV PIXEL_FAUCET=1
ENV PIXEL_TIP_HOST=1
# EVM verified lock (set via Railway after bun run deploy:evm-lock):
# PIXEL_BRIDGE_EVM=1
# PIXEL_EVM_CHAIN=base-sepolia
# PIXEL_EVM_RPC=https://sepolia.base.org
# PIXEL_EVM_LOCK=0x…
# PIXEL_EVM_USDC=0x…

# Persist via Railway Volume mounted at /data/pixel (Docker VOLUME unsupported on Railway).
EXPOSE 8545

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||8545)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "scripts/run-canonical-tip.ts"]
