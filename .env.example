# Canonical tip feed for the site billboard + /wallet (build-time for Vite).
# If unset, /wallet defaults to the crowned public tip.
# Local tip override:
# VITE_PIXEL_RPC=http://127.0.0.1:8545
# Public tip (Lovable / production — set explicitly):
VITE_PIXEL_RPC=https://pixel-tip-production.up.railway.app
VITE_REQUIRE_PUBLIC_TIP=1
#
# Tip host (Railway pixel-tip) — friend invite:
# PIXEL_BRIDGE_LAB=1
# PIXEL_FAUCET=1
# PIXEL_TIP_HOST=1
#
# Tip host — EVM verified USDC lock (MockUSDC venue; Pixel settles native PIX):
# PIXEL_BRIDGE_EVM=1
# PIXEL_EVM_CHAIN=base-sepolia   # sepolia | base-sepolia | amoy | arb-sepolia
# PIXEL_EVM_RPC=https://sepolia.base.org
# PIXEL_EVM_LOCK=0x…
# PIXEL_EVM_USDC=0x…
# Deploy: PIXEL_EVM_DEPLOY_KEY=0x… PIXEL_EVM_CHAIN=amoy bun run deploy:evm-lock

#
# CI / two-node lab only (never for friends):
# PIXEL_ALLOW_LAB_GENESIS=1
#
# Discord invite bot (/pixel join|tip|wallet) — docs/demos/discord-bot.md
# DISCORD_BOT_TOKEN=
# DISCORD_APP_ID=
# DISCORD_GUILD_ID=
# PIXEL_SITE_URL=https://pixel-chain-story.lovable.app
